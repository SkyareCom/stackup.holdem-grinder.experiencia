+html.esq body .btn[data-a="wa"] .ic svg{color:var(--esq-green)!important}
+html.esq body #langBtn .ic svg{color:var(--esq-amber)!important}
+html.esq body .lang .btn#langBtn[aria-expanded="true"]{box-shadow:inset 0 0 0 1px var(--esq-cyan)!important}
