+  --esq-label:'Barlow Condensed','Barlow',sans-serif;
+  --esq-body:'Barlow',system-ui,sans-serif;
+  --esq-cut:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);
