+  background:linear-gradient(180deg,#FFFFFF 0%,#C9D1E0 45%,#6B768C 55%,#AEB8CC 100%)!important;-webkit-background-clip:text!important;background-clip:text!important;
+  color:transparent!important;-webkit-text-fill-color:transparent!important;-webkit-text-stroke:0!important;text-shadow:none!important;
+  filter:drop-shadow(0 4px 0 #0B0F18) drop-shadow(0 10px 18px rgba(0,0,0,.6))!important}
