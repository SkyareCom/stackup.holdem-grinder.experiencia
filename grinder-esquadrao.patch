+html.esq body .legal a{font-family:var(--esq-body)!important;color:var(--esq-cyan)!important}
+html.esq body > .toast,html.esq body main.screen .toast{font-family:var(--esq-label)!important;font-weight:700!important;background:#0B0F18!important;border:1px solid var(--esq-cyan)!important;border-radius:0!important}
+
+/* ---------- LOGO NAS CORES DO ESQUADRÃO ---------- */
+html.esq #grinderSplashLogo,html.esq body main.screen .logo img{content:url(assets/logo-esquadrao-440.png)}
+html.esq #grinderSplash .gs-brand{transform:none!important}
+html.esq #grinderSplash .gs-stackup{font-family:var(--esq-label)!important;font-weight:700!important;font-size:15px!important;letter-spacing:5px!important;color:var(--esq-muted)!important;text-shadow:none!important;-webkit-text-stroke:0!important}
