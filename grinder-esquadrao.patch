   R.innerHTML='<style>'+":host{color-scheme:dark;background:#1a1a1a;\n  --concreto:#86827d;--preto:#000;--branco:#fff;--cinza:#bdbab5;--elefante-esc:#4a4744;\n  --brush:'Bebrush',sans-serif;--rage:'Bebrush',sans-serif}\n*{box-sizing:border-box;margin:0;padding:0}\n\nbody{background:#1a1a1a;color:#fff;font-family:var(--brush);display:flex;justify-content:center;-webkit-tap-highlight-color:transparent}\nbutton{font-family:inherit;color:inherit;cursor:pointer}\n.screen{position:relative;width:100%;max-width:430px;height:100%;max-height:932px;overflow:hidden;background:var(--concreto);display:flex;flex-direction:column}\n@media(min-width:500px){.screen{border-radius:44px;box-shadow:0 0 0 10px #0c0c0c,0 30px 80px rgba(0,0,0,.6);margin-block:auto}}\n/* concreto */\n.concrete{position:absolute;inset:0;z-index:0;pointer-events:none}\n.concrete svg{width:100%;height:100%;display:block}\n.vignette{position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse at 50% 40%,transparent 40%,rgba(0,0,0,.45) 100%)}\n/* ---------- CABE\u00c7ALHO ---------- */\n.header{position:relative;z-index:2;padding:calc(env(safe-area-inset-top) + 1.4vh) 22px 1.4vh;display:flex;flex-direction:column;gap:1.2vh}\n.brandrow{display:flex;align-items:center;gap:12px}\n.brandrow img{width:min(7.5vh,56px);height:min(7.5vh,56px);flex:none;filter:drop-shadow(0 4px 8px rgba(0,0,0,.45))}\n.brandtxt{flex:1;min-width:0;line-height:.9}\n.brandtxt .brand{font-size:min(2.4vh,17px);letter-spacing:1.5px;color:#111;white-space:nowrap}\n.brandtxt .title{font-family:var(--brush);font-size:min(5.6vh,42px);color:#111;letter-spacing:1.5px;line-height:.95}\n.navbtns{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.hbtn{height:min(6.4vh,50px);border-radius:14px;background:#000;border:1px solid #fff;display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px;letter-spacing:1px;transition:background .15s}\n.hbtn svg{width:18px;height:18px;flex:none}\n.hbtn.on{background:rgba(255,255,255,.7);color:#000;border:2px solid #000;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}\n.divider{height:1px;background:rgba(0,0,0,.35);box-shadow:0 1px 0 rgba(255,255,255,.18)}\n/* ---------- CONTE\u00daDO (\u00e1rea livre da tela) ---------- */\n.content{position:relative;z-index:1;flex:1;min-height:0;overflow-y:auto;padding:2vh 22px;display:flex;flex-direction:column;gap:12px}\n.slot{flex:1;min-height:140px;border:1px dashed rgba(0,0,0,.45);border-radius:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:16px;background:rgba(0,0,0,.06)}\n.slot b{font-weight:400;font-size:14px;letter-spacing:1px;color:#111}\n.slot small{font-size:12px;color:#222;opacity:.8;letter-spacing:.5px}\n/* ---------- RODAP\u00c9: 5 atalhos ---------- */\n.tabbar{position:relative;z-index:2;background:#000;border-top:1px solid #fff;padding:8px 8px calc(env(safe-area-inset-bottom) + 8px);display:grid;grid-template-columns:repeat(5,1fr);gap:4px}\n.tab{background:none;border:2px solid transparent;border-radius:14px;height:min(8.4vh,64px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:12px;letter-spacing:.5px;color:#fff;transition:background .15s}\n.tab svg{width:min(3.4vh,24px);height:min(3.4vh,24px)}\n.tab span{white-space:nowrap}\n.tab.on{background:rgba(255,255,255,.7);color:#000;border-color:#000}\n.tab:focus-visible,.hbtn:focus-visible,.toast{position:absolute;left:50%;bottom:calc(min(8.4vh,64px) + 30px + env(safe-area-inset-bottom));transform:translate(-50%,10px);background:#111;color:#fff;padding:10px 16px;border-radius:12px;font-size:12px;letter-spacing:.5px;opacity:0;transition:.25s;z-index:40;border:1px solid #fff;white-space:nowrap;pointer-events:none}\n.toast.show{opacity:1;transform:translate(-50%,0)}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n\n\n/* v3: cabe\u00e7alho mais proporcional e compacto */\n.header{padding:calc(env(safe-area-inset-top) + 1vh) 22px 1vh!important;gap:1vh!important}\n.brandrow{justify-content:center;gap:12px!important}\n.brandrow img{width:min(8.6vh,66px)!important;height:min(8.6vh,66px)!important}\n.brandtxt{flex:0 1 auto!important;display:flex;flex-direction:column;justify-content:center}\n.brandtxt .brand{font-size:min(2.9vh,21px)!important;letter-spacing:2px!important;line-height:1}\n.brandtxt .title{font-size:min(6.6vh,50px)!important;line-height:.9!important;letter-spacing:2px!important;margin-top:2px}\n.navbtns{gap:10px!important}\n.hbtn{height:min(6vh,46px)!important}\n.content{padding-top:1.4vh!important}\n\n\n/* v4b: layout da v3; s\u00f3 GRINDER em Road Rage */\n.brandtxt .title{font-family:'Road Rage','Bebrush',sans-serif!important;-webkit-text-stroke:1.8px #111;paint-order:stroke fill;letter-spacing:2px!important}\n\n\n/* v5: par de ases ao fundo, igual \u00e0 tela inicial */\n.cardsbox{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}\n.cardsbox .cards{position:absolute;left:129.5%;top:44%;height:147.3%;width:auto;max-width:none;opacity:.12;\n  transform:translate(-50%,-50%) rotate(-20deg);user-select:none}\n\n.trainwrap{display:flex;flex-direction:column;gap:10px;padding-bottom:4px}\n.tsec{border:1px solid #fff;border-radius:14px;background:#000;overflow:hidden;transition:opacity .15s}\n.tsec.dis{opacity:.45}\n.thead{width:100%;display:flex;align-items:center;gap:10px;padding:13px 14px;background:none;border:0;text-align:left;color:#fff}\n.thead b{font-weight:400;font-size:14px;letter-spacing:1px;flex:none;max-width:62%}\n.thead small{flex:1;min-width:0;text-align:right;font-size:12px;color:#bdbab5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.thead svg{width:16px;height:16px;flex:none;transition:transform .2s}\n.tsec.open .thead svg{transform:rotate(180deg)}\n.tbody{display:none;flex-direction:column;gap:12px;padding:2px 12px 14px}\n.tsec.open .tbody{display:flex}\n.glabel{font-size:12px;color:#bdbab5;letter-spacing:1px}\n.chips{display:grid;gap:8px}\n.chip{min-height:38px;padding:6px 8px;border-radius:12px;background:#000;border:1px solid #fff;font-size:12px;letter-spacing:.5px;color:#fff;line-height:1.15}\n.chip.on{background:rgba(255,255,255,.7);color:#000;border:2px solid #000}\n.chip:disabled{cursor:not-allowed}\n.towers{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.tower{min-height:min(21vh,158px);border-radius:16px;background:#000;border:1px solid #fff;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:8px;padding:min(3vh,22px) 6px 12px;text-align:center}\n.tower svg{width:min(5.4vh,40px);height:min(5.4vh,40px)}\n.tower b{font-weight:400;font-size:14px;letter-spacing:1px;line-height:1.1}\n.tower small{font-size:12px;color:#bdbab5;letter-spacing:.3px;line-height:1.2}\n.tower.on{background:rgba(255,255,255,.7);color:#000;border:2px solid #000}\n.tower.on small{color:#4a4744}\n.tower:focus-visible{outline:2px solid #fff;outline-offset:2px}\n.tnote{font-size:12px;color:#bdbab5;letter-spacing:.5px}\n.tstartbar{position:sticky;bottom:-2vh;margin-top:4px;padding:10px 0 2vh;background:linear-gradient(180deg,rgba(134,130,125,0),#86827d 40%)}\n.tstart{width:100%;height:min(6.8vh,52px);border-radius:14px;background:#000;border:1px solid #fff;color:#fff;font-size:14px;letter-spacing:1.5px}\n.tstart.on{background:rgba(255,255,255,.7);color:#000;border:2px solid #000}\n\n/* gavetas: cabe\u00e7alho \u00e9 o bot\u00e3o; conte\u00fado abre direto no fundo, sem borda secund\u00e1ria */\n.tsec{background:none!important;border:0!important;border-radius:0!important;overflow:visible!important}\n.thead{background:#000;border:1px solid #fff!important;border-radius:14px}\n.tsec.open .thead{border-radius:14px}\n.tbody{padding:10px 0 6px!important}\n.glabel{color:#2a2826!important}\n.tnote{color:#2a2826!important}\n.trainwrap{gap:10px!important}\n/* REGRA: cards e bot\u00f5es sempre 12px \u2014 hierarquia s\u00f3 pela cor */\n.hbtn,.tab,.tab span,.thead b,.thead small,.chip,.tower b,.tower small,.tstart,.slot b,.slot small,.glabel,.tnote{font-size:12px!important}\n.tower b,.thead b,.slot b{color:inherit}\n.thead b{color:#fff}.thead small{color:#bdbab5}\n/* gaveta aberta = efeito de clique (vidro branco) at\u00e9 tocar de novo */\n.tsec.open .thead{background:rgba(255,255,255,.7)!important;border:2px solid #000!important;color:#000!important;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}\n.tsec.open .thead b{color:#000!important}.tsec.open .thead small{color:#4a4744!important}\n/* paleta A \u00b7 Grafite \u2014 cards secund\u00e1rios das gavetas */\n.chip,.tower{background:#2b2926!important;border:1px solid rgba(255,255,255,.35)!important;color:#e8e6e2!important}\n.tower small{color:#a8a49e!important}\n.chip.on,.tower.on{background:rgba(255,255,255,.7)!important;border:2px solid #000!important;color:#000!important}\n.tower.on small{color:#4a4744!important}\n\n*{font-weight:400!important;-webkit-text-stroke:0!important}\n/* Modo de jogo: torres em roxo escuro */\n.tower{background:rgba(20,6,40,.9)!important;border:1px solid #fff!important;color:#c9a6ff!important;\n  -webkit-backdrop-filter:blur(12px) saturate(150%);backdrop-filter:blur(12px) saturate(150%)}\n.tower svg{color:#c9a6ff}\n.tower b{color:#c9a6ff!important}\n.tower small{color:#fff!important;white-space:pre-line}\n.tower.on{background:rgba(255,255,255,.7)!important;border:2px solid #000!important;color:#000!important}\n.tower.on svg,.tower.on b{color:#000!important}\n.tower.on small{color:#4a4744!important}\n/* Modo de jogo: cor por modo (formato regular) */\n.towers{gap:8px!important;align-items:stretch}\n.tower{min-height:min(14vh,108px)!important;justify-content:center!important;padding:10px 6px!important;gap:10px!important}\n.tower[data-o=\"cash\"]{background:rgba(4,40,20,.86)!important}\n.tower[data-o=\"cash\"] svg,.tower[data-o=\"cash\"] b{color:#4ade80!important}\n.tower[data-o=\"mtt\"]{background:rgba(46,32,2,.86)!important}\n.tower[data-o=\"mtt\"] svg,.tower[data-o=\"mtt\"] b{color:#f5c542!important}\n.tower.on{background:rgba(255,255,255,.7)!important;border:2px solid #000!important}\n.tower.on svg,.tower.on b{color:#000!important}\n/* cards internos: clique = invers\u00e3o das cores do card */\n.chip.on{background:#e8e6e2!important;color:#2b2926!important;border:1px solid #2b2926!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}\n.tower.on{-webkit-backdrop-filter:none!important;backdrop-filter:none!important;border:1px solid #000!important}\n.tower[data-o=\"random\"].on{background:#c9a6ff!important}\n.tower[data-o=\"random\"].on svg,.tower[data-o=\"random\"].on b{color:#140628!important}\n.tower[data-o=\"cash\"].on{background:#4ade80!important}\n.tower[data-o=\"cash\"].on svg,.tower[data-o=\"cash\"].on b{color:#042814!important}\n.tower[data-o=\"mtt\"].on{background:#f5c542!important}\n.tower[data-o=\"mtt\"].on svg,.tower[data-o=\"mtt\"].on b{color:#2e2002!important}\n/* cards internos (op\u00e7\u00f5es): sem clique = branco/borda preta; clicado = preto/borda branca */\n.chip{background:#f2f0ec!important;border:1px solid #000!important;color:#111!important}\n.chip.on{background:#000!important;border:1px solid #fff!important;color:#fff!important}\n/* Modo de jogo segue o padr\u00e3o dos cards internos (sem cores) */\n.tower,.tower[data-o]{background:#f2f0ec!important;border:1px solid #000!important;color:#111!important;-webkit-backdrop-filter:none!important;backdrop-filter:none!important}\n.tower svg,.tower b,.tower[data-o] svg,.tower[data-o] b{color:#111!important}\n.tower.on,.tower[data-o].on{background:#000!important;border:1px solid #fff!important}\n.tower.on svg,.tower.on b,.tower[data-o].on svg,.tower[data-o].on b{color:#fff!important}\n*,.hbtn,.tab,.ptitle,.slot,.thead,.tsec .thead,.chip,.chip.on,.tower,.tower.on,.tower[data-o],.tower[data-o].on,.tabbar{border-width:2px!important}\n.chip[data-o=\"all\"]{grid-column:1/-1}